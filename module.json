{
  "id": "marvel-encounter-packs",
  "type": "module",
  "title": "Marvel Encounter Packs",
  "description": "Reusable encounter content for the Marvel Encounter Framework.",
  "version": "0.3.0",
  "url": "https://github.com/DeadEzrah/marvel-encounter-packs",
  "manifest": "https://raw.githubusercontent.com/DeadEzrah/marvel-encounter-packs/main/module.json",
